# Copy to .env.local for local testing against the real database, or set these in Vercel.
# Without them, the app saves to the local "Home Inventory/data" folder instead.

# Supabase project that holds the hi_records table and the private "home-inventory" photo bucket.
SUPABASE_URL=https://rmshsswlodfvdffnlqdy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_here

# Optional: signs sign-in cookies. If unset, one is derived from the service key.
SESSION_SECRET=

# Optional: photo bucket name (default home-inventory).
HOME_INVENTORY_BUCKET=home-inventory

# Optional: SHA-256 fingerprint(s) of the Android signing key, comma separated.
# The release workflow prints it. Lets the Android app open full-screen with no address bar.
ANDROID_CERT_SHA256=
